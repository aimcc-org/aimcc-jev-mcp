# Provider：auto | typesafe | openrouter | compatible | local
# auto 在没有任何云端 Key 时自动使用本地 OpenJev。
JEV_PROVIDER=auto

# 云端 Provider 可设置 JEV_MODEL=jev-1.13。
# 本地模型默认使用下面的原模型及其 Transformers.js ONNX 转换。
# JEV_MODEL=jev-1.13
JEV_LOCAL_MODEL_REPO=onnx-community/open-jev-deberta-v3-large-ONNX
JEV_LOCAL_DTYPE=q4

# TypeSafe 直连
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# OpenRouter Decisions API
OPENROUTER_API_KEY=
JEV_OPENROUTER_BASE_URL=https://openrouter.ai/api

# Jev 兼容端点（完整请求 URL）
JEV_API_KEY=
JEV_API_BASE_URL=

# 传输保护
JEV_REQUEST_TIMEOUT_MS=60000
JEV_MAX_ATTEMPTS=3
JEV_MAX_RESPONSE_BYTES=1000000
